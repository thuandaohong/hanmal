---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StrokeOrder from '../../components/StrokeOrder.astro';
import StrokeSteps from '../../components/StrokeSteps.astro';
import SpeechNotice from '../../components/SpeechNotice.astro';
import { BASIC_CONSONANTS, BASIC_VOWELS, JAMO, type Jamo } from '../../data/jamo';
import { gloss, wordUrl, wordsStartingWith } from '../../data/words';
import { type Key, getLang, linker, translator } from '../../i18n';
import { compose } from '../../lib/hangul/compose';
import { romanize } from '../../lib/hangul/romanize';

export function getStaticPaths() {
  return JAMO.map((j) => ({ params: { jamo: j.char }, props: { j } }));
}
const { j } = Astro.props as { j: Jamo };
const lang = getLang(Astro);
const l = linker(lang);
const tr = translator(lang);

const isC = j.kind === 'consonant';
// Âm tiết mẫu để nghe và luyện: phụ âm + nguyên âm cơ bản, hoặc nguyên âm sau các phụ âm cơ bản.
const syllables = isC
  ? BASIC_VOWELS.map((v) => compose({ c: j.char, v: v.char, f: '' }))
  : BASIC_CONSONANTS.map((c) => compose({ c: c.char, v: j.char, f: '' }));
const sample = isC ? compose({ c: j.char, v: 'ㅏ', f: '' }) : compose({ c: 'ㅇ', v: j.char, f: '' });
const examples = wordsStartingWith(j.char, j.kind);
const idx = JAMO.indexOf(j);
const prev = JAMO[idx - 1];
const next = JAMO[idx + 1];
const groupKey = `group.${j.group}` as Key;

const facts: [string, string][] = [
  [tr('jamo.name'), j.name],
  ...(isC
    ? ([
        [tr('jamo.initial'), j.roman[0] || tr('jamo.silent')],
        [tr('jamo.final'), j.roman[1] ?? tr('jamo.noFinal')],
      ] as [string, string][])
    : ([[tr('jamo.roman'), j.roman[0]]] as [string, string][])),
  ['IPA', `[${j.ipa}]`],
  ...(j.place ? ([[tr('jamo.place'), tr(`place.${j.place}` as Key)]] as [string, string][]) : []),
];
---
<BaseLayout
  title={tr('jamo.pageTitle', { char: j.char, name: j.name })}
  description={tr('jamo.pageDescription', { char: j.char, name: j.name })}
>
  <PageHeader
    title={tr('jamo.pageTitle', { char: j.char, name: j.name })}
    crumbs={[{ label: tr('nav.hangul'), href: l('/hangul') }, { label: j.char }]}
  />

  <section class="container-page grid gap-10 py-10 md:grid-cols-[16rem_1fr]">
    <div>
      <StrokeOrder char={j.char} paths={j.strokes} />
      <nav class="mx-auto mt-4 flex max-w-60 justify-between text-sm md:max-w-none" aria-label={tr('nav.hangul')}>
        {prev ? <a href={l(`/hangul/${prev.char}`)} lang="ko" class="link-underline">← {prev.char}</a> : <span />}
        {next && <a href={l(`/hangul/${next.char}`)} lang="ko" class="link-underline">{next.char} →</a>}
      </nav>
    </div>

    <div>
      <p class="text-sm font-semibold tracking-wide text-fg-muted uppercase">{tr(groupKey)}</p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <p class="text-3xl font-bold"><span lang="ko">{j.char}</span> <span class="text-brand">{j.roman.filter(Boolean).join(' / ') || '∅'}</span></p>
        <button type="button" data-speak={isC ? `${j.name}. ${sample}` : sample} class="inline-flex items-center gap-1.5 rounded-full bg-brand px-4 py-2 text-sm font-semibold text-on-brand hover:opacity-90">
          🔊 {tr('jamo.listen')}
        </button>
      </div>
      <p class="mt-3 max-w-2xl text-fg-muted">{tr(`groupNote.${j.group}` as Key)}</p>

      <dl class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3">
        {facts.map(([label, value]) => (
          <div class="rounded-xl border border-line bg-surface p-4">
            <dt class="text-xs text-fg-muted">{label}</dt>
            <dd class="mt-1 font-semibold" lang={label === tr('jamo.name') ? 'ko' : undefined}>{value}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-4"><SpeechNotice /></div>

      {j.related.length > 0 && (
        <p class="mt-6 text-sm text-fg-muted">
          {tr('jamo.related')}:{' '}
          {j.related.map((r, i) => (
            <>{i > 0 && ' · '}<a href={l(`/hangul/${r}`)} lang="ko" class="link-underline text-lg font-semibold text-fg">{r}</a></>
          ))}
        </p>
      )}
    </div>
  </section>

  <section class="border-t border-dashed border-line">
    <div class="container-page py-10">
      <h2 class="mb-6 text-xl font-bold">{tr('jamo.strokeOrder')}</h2>
      <StrokeSteps char={j.char} count={j.strokes.length} />
    </div>
  </section>

  <section class="border-t border-dashed border-line">
    <div class="container-page py-10">
      <h2 class="mb-6 text-xl font-bold">{tr('jamo.syllables', { char: j.char })}</h2>
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(4.5rem,1fr))] gap-2">
        {syllables.map((s) => (
          <li>
            <button type="button" data-speak={s} class="flex w-full flex-col items-center rounded-lg border border-line bg-surface py-3 hover:border-brand/60 hover:text-brand">
              <span lang="ko" class="text-2xl font-semibold">{s}</span>
              <span class="text-xs text-fg-muted">{romanize(s)}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {examples.length > 0 && (
    <section class="border-t border-dashed border-line">
      <div class="container-page py-10">
        <h2 class="mb-6 text-xl font-bold">{tr('jamo.examples')}</h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {examples.map((w) => (
            <li>
              <a href={wordUrl(w.w, lang)} class="block rounded-xl border border-line bg-surface px-4 py-3 hover:border-brand/60">
                <span lang="ko" class="text-xl font-semibold">{w.w}</span>
                <span class="ml-2 text-sm text-fg-muted">{romanize(w.w)}</span>
                <span class="mt-1 block truncate text-sm">{gloss(w, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SpeechNotice from '../../components/SpeechNotice.astro';
import { GRAMMAR, type GrammarPoint, equivalent, grammarMeaning, grammarUrl, kindKey } from '../../data/grammar';
import { LEVELS, wordUrl, BY_WORD } from '../../data/words';
import { getLang, linker, translator } from '../../i18n';
import { SAMPLE_VERBS, formExamples } from '../../lib/hangul/grammar';
import { compareTitle, compareUrl, comparesFor } from '../../data/grammar-compare';
import { exampleTr } from '../../data/examples';

export function getStaticPaths() {
  return GRAMMAR.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props as { g: GrammarPoint };
const lang = getLang(Astro);
const l = linker(lang);
const tr = translator(lang);
const level = LEVELS.find((lv) => lv.level === g.level)!;
const meaning = grammarMeaning(g, lang);
// Mô tả trang: thêm dấu câu nếu bản dịch krdict không kết thúc bằng dấu chấm.
const meaningSentence = !meaning || /[.!?。．]$/.test(meaning.trim()) ? meaning.trim() : meaning.trim() + (lang === 'ja' ? '。' : '.');
const formation = formExamples(g.forms, g.slug);
const i = GRAMMAR.indexOf(g);
const [prev, next] = [GRAMMAR[i - 1], GRAMMAR[i + 1]];
const compares = comparesFor(g.slug);
// Dữ liệu có cấu trúc: một bài học ngữ pháp tiếng Hàn.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: g.title,
  description: meaning || undefined,
  url: new URL(grammarUrl(g.slug, lang), Astro.site).href,
  inLanguage: lang,
  learningResourceType: 'Grammar',
  educationalLevel: g.level === 1 ? 'TOPIK I' : 'TOPIK II',
  teaches: g.title,
  about: { '@type': 'Language', name: 'Korean', alternateName: 'ko' },
  isAccessibleForFree: true,
};
---
<BaseLayout title={tr('grammar.pageTitle', { title: g.title })} description={tr('grammar.pageDescription', { title: g.title, meaning: meaningSentence })} jsonLd={jsonLd}>
  <PageHeader
    title={g.title}
    crumbs={[{ label: tr('nav.grammar'), href: l('/grammar') }, { label: tr(level.key), href: `${l('/grammar')}#level-${g.level}` }, { label: g.title }]}
  >
    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <span class="rounded-full bg-brand-soft px-3 py-1 font-semibold text-brand-ink">{tr(level.key)} · {level.topik}</span>
      <span class="rounded-full border border-line px-3 py-1">{tr(kindKey(g))}</span>
      <span class="text-fg-muted">{tr('grammar.variants')}: <span lang="ko">{g.forms.join(' · ')}</span></span>
    </div>
    {meaning && <p class="mt-4 max-w-3xl text-lg">{meaning}</p>}
  </PageHeader>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[1fr_22rem]">
    <div class="min-w-0 space-y-10">
      <section>
        <h2 class="mb-4 text-xl font-bold">{tr('grammar.meaning')}</h2>
        <ol class="space-y-5">
          {g.senses.map((s, si) => {
            const eq = equivalent(s, lang);
            return (
              <li class="flex gap-3">
                <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-bg-muted text-xs font-semibold">{si + 1}</span>
                <div class="min-w-0">
                  {eq && <p class="font-semibold">{eq}</p>}
                  {s.eq[lang] && <p class="text-fg-muted">{s.eq[lang]![1]}</p>}
                  <p lang="ko" class="mt-1 text-sm text-fg-muted">{s.ko}</p>
                </div>
              </li>
            );
          })}
        </ol>
      </section>

      {g.examples.length > 0 && (
        <section>
          <h2 class="mb-4 text-xl font-bold">{tr('grammar.examples')}</h2>
          <SpeechNotice />
          <ul class="mt-3 space-y-2">
            {g.examples.map((lines) => (
              <li class="rounded-lg border-l-2 border-brand/40 bg-bg-muted/60 px-4 py-2.5">
                {lines.map((line) => (
                  <>
                    <button type="button" data-speak={line} lang="ko" class="block text-left text-lg hover:text-brand">{line}</button>
                    {exampleTr(line, lang) && <p class="text-sm text-fg-muted">{exampleTr(line, lang)}</p>}
                  </>
                ))}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <aside class="space-y-8">
      {formation.length > 0 && (
        <section class="rounded-xl border border-line bg-surface p-5">
          <h2 class="font-bold">{tr('grammar.formation')}</h2>
          {SAMPLE_VERBS.every((v) => formation.some((e) => e.base === v)) && <p class="mt-1 text-xs text-fg-muted">{tr('grammar.formationNote')}</p>}
          <table class="mt-3 w-full text-sm">
            <thead class="text-left text-xs text-fg-muted">
              <tr><th class="py-1 font-normal">{tr('grammar.base')}</th><th class="py-1 text-right font-normal">{tr('grammar.result')}</th></tr>
            </thead>
            <tbody>
              {formation.map((e) => (
                <tr class="border-t border-line">
                  <td class="py-2" lang="ko">
                    {BY_WORD.has(e.base) ? <a href={wordUrl(e.base, lang)} class="hover:text-brand">{e.base}</a> : e.base}
                  </td>
                  <td class="py-2 text-right"><button type="button" data-speak={e.result} lang="ko" class="font-semibold hover:text-brand">{e.result}</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )}
      {compares.length > 0 && (
        <section class="rounded-xl border border-line bg-surface p-5">
          <h2 class="font-bold">{tr('compare.confusedWith')}</h2>
          <ul class="mt-3 space-y-1.5">
            {compares.map((c) => <li><a href={compareUrl(c.slug, lang)} lang="ko" class="link-underline">{compareTitle(c)}</a></li>)}
          </ul>
        </section>
      )}
      <nav class="flex justify-between gap-3 text-sm" aria-label={tr('grammar.prevNext')}>
        {prev ? <a href={grammarUrl(prev.slug, lang)} lang="ko" class="link-underline">← {prev.title}</a> : <span />}
        {next && <a href={grammarUrl(next.slug, lang)} lang="ko" class="link-underline text-right">{next.title} →</a>}
      </nav>
    </aside>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ListFilter from '../../components/ListFilter.astro';
import { GRAMMAR, grammarMeaning, grammarUrl, kindKey } from '../../data/grammar';
import { LEVELS } from '../../data/words';
import { getLang, translator } from '../../i18n';

const lang = getLang(Astro);
const tr = translator(lang);
const lead = tr('grammar.lead', { n: GRAMMAR.length });
---
<BaseLayout title={tr('grammar.title')} description={lead}>
  <PageHeader title={tr('grammar.title')} crumbs={[{ label: tr('nav.grammar') }]} lead={lead}>
    <nav class="mt-6 flex flex-wrap gap-2" aria-label={tr('vocab.jump')}>
      {LEVELS.map((lv) => <a href={`#level-${lv.level}`} class="rounded-full border border-line px-4 py-1.5 text-sm hover:border-brand">{tr(lv.key)}</a>)}
    </nav>
    <div class="mt-4"><ListFilter /></div>
  </PageHeader>
  {LEVELS.map((lv) => {
    const items = GRAMMAR.filter((g) => g.level === lv.level);
    return (
      <section id={`level-${lv.level}`} data-filter-section class="container-page scroll-mt-20 py-10">
        <h2 class="mb-5 text-2xl font-bold">{tr(lv.key)} · {lv.topik} <span class="text-base font-normal text-fg-muted">({items.length})</span></h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((g) => {
            const meaning = grammarMeaning(g, lang);
            return (
              <li class="min-w-0" data-filter={`${g.title} ${g.forms.join(' ')} ${meaning}`.toLowerCase()}>
                <a href={grammarUrl(g.slug, lang)} class="block h-full rounded-xl border border-line bg-surface px-4 py-3 transition hover:border-brand/60">
                  <span class="flex items-baseline justify-between gap-2">
                    <span lang="ko" class="text-lg font-semibold">{g.title}</span>
                    <span class="shrink-0 text-xs text-fg-muted">{tr(kindKey(g))}</span>
                  </span>
                  <span class="mt-1 line-clamp-2 block text-sm text-fg-muted">{meaning}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</BaseLayout>

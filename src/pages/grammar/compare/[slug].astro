---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SpeechNotice from '../../../components/SpeechNotice.astro';
import { type Compare, COMPARES, compareLevel, comparePoints, compareTitle, compareUrl, isWrong } from '../../../data/grammar-compare';
import { grammarMeaning, grammarUrl } from '../../../data/grammar';
import { LEVELS } from '../../../data/words';
import { getLang, linker, translator } from '../../../i18n';

export function getStaticPaths() {
  return COMPARES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Compare };
const lang = getLang(Astro);
const l = linker(lang);
const tr = translator(lang);
const points = comparePoints(c);
const title = compareTitle(c);
const text = c.text[lang];
const level = LEVELS.find((lv) => lv.level === compareLevel(c))!;
const others = COMPARES.filter((x) => x !== c && x.pair.some((s) => c.pair.includes(s)));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: tr('compare.pageTitle', { title }),
  description: text.summary,
  url: new URL(compareUrl(c.slug, lang), Astro.site).href,
  inLanguage: lang,
  learningResourceType: 'Grammar',
  educationalLevel: level.topik,
  teaches: title,
  about: { '@type': 'Language', name: 'Korean', alternateName: 'ko' },
  isAccessibleForFree: true,
};
---
<BaseLayout title={tr('compare.pageTitle', { title })} description={tr('compare.pageDescription', { title, summary: text.summary })} jsonLd={jsonLd}>
  <PageHeader
    title={title}
    crumbs={[{ label: tr('nav.grammar'), href: l('/grammar') }, { label: tr('nav.grammarCompare'), href: l('/grammar/compare') }, { label: title }]}
  >
    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
      <span class="rounded-full bg-brand-soft px-3 py-1 font-semibold text-brand-ink">{tr(level.key)} · {level.topik}</span>
    </div>
    <p class="mt-4 max-w-3xl text-lg">{text.summary}</p>
  </PageHeader>

  <div class="container-page space-y-10 py-10">
    <section class={`grid gap-3 ${points.length > 2 ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
      {points.map((g) => (
        <a href={grammarUrl(g.slug, lang)} class="block rounded-xl border border-line bg-surface p-5 transition hover:border-brand/50">
          <span lang="ko" class="block text-xl font-bold">{g.title}</span>
          <span class="mt-1.5 block text-sm text-fg-muted">{grammarMeaning(g, lang)}</span>
        </a>
      ))}
    </section>

    <section>
      <h2 class="mb-4 text-xl font-bold">{tr('compare.rules')}</h2>
      <ul class="max-w-3xl list-disc space-y-2 pl-5">
        {text.points.map((p) => <li>{p}</li>)}
      </ul>
    </section>

    <section>
      <h2 class="mb-4 text-xl font-bold">{tr('compare.examples')}</h2>
      <SpeechNotice />
      <ul class="mt-3 max-w-3xl space-y-2">
        {c.examples.map((e) => {
          const wrong = isWrong(e);
          const ko = wrong ? e.ko.slice(2) : e.ko;
          const tag = wrong ? tr('compare.wrong') : e.use === 'both' ? tr('compare.both') : points.find((g) => g.slug === e.use)?.title;
          return (
            <li class={`rounded-lg border-l-2 px-4 py-2.5 ${wrong ? 'border-accent/60 bg-accent/5' : 'border-brand/40 bg-bg-muted/60'}`}>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                {wrong ? (
                  <p lang="ko" class="text-lg text-fg-muted line-through decoration-accent/60">{ko}</p>
                ) : (
                  <button type="button" data-speak={ko} lang="ko" class="text-left text-lg hover:text-brand">{ko}</button>
                )}
                {tag && <span lang={wrong || e.use === 'both' ? undefined : 'ko'} class={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold ${wrong ? 'text-accent' : 'bg-surface text-fg-muted'}`}>{tag}</span>}
              </div>
              <p class="mt-1 text-sm text-fg-muted">{e.tr[lang]}</p>
            </li>
          );
        })}
      </ul>
    </section>

    {others.length > 0 && (
      <section>
        <h2 class="mb-4 text-xl font-bold">{tr('compare.confusedWith')}</h2>
        <ul class="flex flex-wrap gap-2">
          {others.map((x) => <li><a href={compareUrl(x.slug, lang)} lang="ko" class="inline-block rounded-full border border-line px-4 py-1.5 text-sm hover:border-brand">{compareTitle(x)}</a></li>)}
        </ul>
      </section>
    )}
    <p><a href={l('/grammar/compare')} class="link-underline">← {tr('compare.allPairs')}</a></p>
  </div>
</BaseLayout>

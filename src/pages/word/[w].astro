---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SpeechNotice from '../../components/SpeechNotice.astro';
import WordList from '../../components/WordList.astro';
import {
  LEVELS, WORDS, type Word, equivalentOf, gloss, irregularLabel, irregularOf, kindOf, neighbors, posLabel, sameTopic, topicOf, wordUrl,
} from '../../data/words';
import { type Key, getLang, linker, translator } from '../../i18n';
import { BY_HANJA, WORD_HANJA, hanjaUrl } from '../../data/hanja';
import { hasHanja } from '../../data/site';
import { type FormKey, conjugate } from '../../lib/hangul/conjugate';
import { pronounce } from '../../lib/hangul/pronounce';
import { romanize } from '../../lib/hangul/romanize';
import { exampleTr } from '../../data/examples';

export function getStaticPaths() {
  return WORDS.map((word) => ({ params: { w: word.w }, props: { word } }));
}
const { word } = Astro.props as { word: Word };
const lang = getLang(Astro);
const l = linker(lang);
const tr = translator(lang);

const level = LEVELS.find((lv) => lv.level === word.level)!;
// Danh từ: ㄱ/ㄷ/ㅂ + ㅎ giữ h khi phiên âm (백화점 → baekhwajeom).
const roman = romanize(word.w, { noun: word.entries[0]?.pos === '명사' });
const meaning = gloss(word, lang);
const topic = topicOf(word);
const related = sameTopic(word);
const [prev, next] = neighbors(word);
// Âm Hán Việt (vi) hoặc dạng chữ Nhật (ja) của từ gốc Hán; chữ có trang riêng thì gắn link.
const wh = hasHanja(lang) ? WORD_HANJA[word.w] : undefined;
const hanjaLink = (c: string) => (hasHanja(lang) && BY_HANJA.has(c) ? hanjaUrl(c, lang) : undefined);

// Cách đọc chuẩn lấy từ từ điển. Chỉ giải thích luật biến âm khi bộ máy cho cùng kết quả với từ điển.
const first = word.entries[0];
const standard = first.pron[0] ?? word.w;
const verbal = !!kindOf(first) && word.w.endsWith('다');
const analysis = pronounce(word.w, {
  stemEnd: verbal ? word.w.length - 2 : undefined,
  sino: /[㐀-鿿]/.test(first.origin ?? ''),
});
const rules = analysis.text === standard ? [...new Set(analysis.changes.map((c) => c.rule))] : [];

// Bảng chia rút gọn cho động/tính từ; đầy đủ ở công cụ chia động từ.
const SHOWN: FormKey[] = [
  'present.polite', 'present.formal', 'past.polite', 'future.polite', 'negative.long', 'honorific',
  'connective.so', 'connective.if', 'modifier.present', 'modifier.past',
];
const conj = word.entries.flatMap((e) => {
  const kind = kindOf(e);
  const irr = irregularOf(word.w, e);
  if (!kind || !irr) return [];
  try {
    return [{ kind, irr, forms: conjugate(word.w, kind, irr) }];
  } catch {
    return [];
  }
})[0];

// Tiêu đề có nghĩa ngắn (người tìm thường gõ "학교 nghĩa là gì", "trường học tiếng Hàn").
// Bản dịch tiếng Nhật của krdict có dạng "たべる【食べる】。くう…": lấy chữ trong 【】 của nghĩa đầu.
const firstGloss = meaning.split(/[,;、，。]/)[0].trim();
const shortGloss = lang === 'ja' ? (firstGloss.match(/【([^】]+)】/)?.[1].split('・')[0] ?? firstGloss) : firstGloss;
const cap = (x: string) => (lang === 'vi' || lang === 'id' ? x[0].toUpperCase() + x.slice(1) : x);
const titleFor = (key: Key) => tr(key, { word: word.w, gloss: cap(shortGloss) });
const title = !shortGloss || [...shortGloss].length > 32
  ? tr('vocab.wordTitle', { word: word.w })
  : [...titleFor('vocab.wordTitleGloss')].length <= 52 ? titleFor('vocab.wordTitleGloss') : titleFor('vocab.wordTitleGlossShort');
const description = tr(verbal ? 'vocab.wordDescriptionVerb' : 'vocab.wordDescription', {
  word: word.w, roman, gloss: meaning, pron: standard, pos: posLabel(first.pos, lang), level: `${lang === 'ja' ? tr(level.key) : tr(level.key).toLowerCase()} (${level.topik})`,
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: word.w,
  alternateName: roman,
  description: meaning,
  inLanguage: 'ko',
  url: new URL(wordUrl(word.w, lang), Astro.site).href,
  inDefinedTermSet: new URL(l(`/vocabulary/${level.slug}`), Astro.site).href,
};
---
<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
>
  <PageHeader
    title={word.w}
    titleLang="ko"
    crumbs={[
      { label: tr('nav.vocabulary'), href: l('/vocabulary') },
      { label: tr(level.key), href: l(`/vocabulary/${level.slug}`) },
      { label: word.w },
    ]}
  >
    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-lg text-fg-muted">{roman}</span>
      <span lang="ko" class="text-lg">[{standard}]</span>
      <button type="button" data-speak={word.w} class="inline-flex items-center gap-1.5 rounded-full bg-brand px-4 py-1.5 text-sm font-semibold text-on-brand hover:opacity-90">
        🔊 {tr('jamo.listen')}
      </button>
      <a href={l(`/vocabulary/${level.slug}`)} class="rounded-full bg-brand-soft px-3 py-1 text-sm font-semibold text-brand-ink">{tr(level.key)} · {level.topik}</a>
      {topic && (
        <a href={l(`/vocabulary/topics/${topic.topic.slug}`)} class="rounded-full border border-line px-3 py-1 text-sm hover:border-brand">
          {topic.sub?.name[lang] ?? topic.topic.name[lang]}
        </a>
      )}
    </div>
    <p class="mt-4 text-2xl font-semibold text-brand">{meaning}</p>
  </PageHeader>

  <div class="container-page grid gap-10 py-10 lg:grid-cols-[1fr_20rem]">
    <div class="min-w-0 space-y-10">
      <SpeechNotice />
      {word.entries.map((e, ei) => (
        <section>
          <h2 class="flex flex-wrap items-baseline gap-x-3 text-lg font-bold">
            {word.entries.length > 1 && <span class="text-fg-muted">{ei + 1}.</span>}
            <span>{posLabel(e.pos, lang)}</span>
            {e.origin && (
              <span class="font-normal text-fg-muted">
                {tr('vocab.origin')}:{' '}
                <span lang={lang === 'ja' ? 'ja' : 'ko'} class="font-hanja text-fg">
                  {[...(lang === 'ja' && wh?.id === e.id ? wh.ja : e.origin)].map((c, ci) => {
                    const href = hanjaLink([...e.origin!][ci]);
                    return href ? <a href={href} class="link-underline">{c}</a> : c;
                  })}
                </span>
                {lang === 'vi' && wh?.id === e.id && wh.hv && <span class="ml-2 font-semibold text-brand">{wh.hv}</span>}
              </span>
            )}
          </h2>
          <ol class="mt-4 space-y-6">
            {e.senses.map((s, si) => (
              <li class="flex gap-3">
                <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-bg-muted text-xs font-semibold">{si + 1}</span>
                <div class="min-w-0">
                  {s.eq[lang] && (
                    <>
                      <p class="font-semibold">{equivalentOf(word.w, s, lang)}</p>
                      <p class="text-fg-muted">{s.eq[lang]![1]}</p>
                    </>
                  )}
                  <p lang="ko" class="mt-1 text-sm text-fg-muted"><span class="sr-only">{tr('vocab.koreanDefinition')}: </span>{s.ko}</p>
                  {s.ex.length > 0 && (
                    <ul class="mt-3 space-y-2">
                      {s.ex.map((lines) => (
                        <li class="rounded-lg border-l-2 border-brand/40 bg-bg-muted/60 px-3 py-2">
                          {lines.map((line) => (
                            <>
                              <button type="button" data-speak={line} lang="ko" class="block text-left hover:text-brand">{line}</button>
                              {exampleTr(line, lang) && <p class="text-sm text-fg-muted">{exampleTr(line, lang)}</p>}
                            </>
                          ))}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    <aside class="space-y-8">
      {rules.length > 0 && (
        <section class="rounded-xl border border-line bg-surface p-5">
          <h2 class="font-bold">{tr('vocab.pronRules')}</h2>
          <p lang="ko" class="mt-2 text-lg">{word.w} → [{standard}]</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
            {rules.map((r) => <li>{tr(`rule.${r}` as Key)}</li>)}
          </ul>
          <a href={`${l('/tools/pronunciation')}?q=${encodeURIComponent(word.w)}`} class="link-underline mt-3 inline-block text-sm">{tr('nav.pronunciation')} →</a>
        </section>
      )}

      {conj && (
        <section class="rounded-xl border border-line bg-surface p-5">
          <h2 class="font-bold">{tr('vocab.conjugation')}</h2>
          <p class="mt-1 text-sm text-fg-muted">{irregularLabel(conj.irr, lang)}</p>
          <dl class="mt-3 divide-y divide-line text-sm">
            {SHOWN.filter((k) => conj.forms[k]).map((k) => (
              <div class="flex justify-between gap-3 py-1.5">
                <dt class="text-fg-muted">{tr(`form.${k}` as Key)}</dt>
                <dd lang="ko" class="text-right font-semibold">{conj.forms[k]}</dd>
              </div>
            ))}
          </dl>
          <a href={`${l('/tools/conjugator')}?q=${encodeURIComponent(word.w)}`} class="link-underline mt-3 inline-block text-sm">{tr('vocab.conjugationAll')} →</a>
        </section>
      )}

      <nav class="flex justify-between text-sm" aria-label={tr('vocab.prevNext')}>
        {prev ? <a href={wordUrl(prev.w, lang)} lang="ko" class="link-underline">← {prev.w}</a> : <span />}
        {next && <a href={wordUrl(next.w, lang)} lang="ko" class="link-underline">{next.w} →</a>}
      </nav>
    </aside>
  </div>

  {related.length > 0 && topic && (
    <section class="border-t border-dashed border-line">
      <div class="container-page py-10">
        <h2 class="mb-5 text-xl font-bold">{tr('vocab.sameTopic', { topic: topic.sub?.name[lang] ?? topic.topic.name[lang] })}</h2>
        <WordList words={related} />
      </div>
    </section>
  )}
</BaseLayout>

---
// Thông báo khi trình duyệt không có giọng đọc tiếng Hàn (ẩn mặc định, script hiện khi cần).
import { getLang, t } from '../i18n';
const lang = getLang(Astro);
---
<p data-speech-unavailable hidden class="rounded-lg border border-accent/40 bg-accent/5 px-4 py-3 text-sm">
  {t(lang, 'speech.unavailable')}
</p>
<script>
  import { initSpeech } from '../scripts/speech';
  initSpeech();
</script>

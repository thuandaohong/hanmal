{
  "name": "korean-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "predev": "node scripts/gen-locale-routes.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/check-i18n.mjs && node scripts/gen-locale-routes.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-dist.mjs && node scripts/check-links.mjs",
    "preview": "astro preview",
    "preview:cf": "wrangler pages dev dist",
    "data": "node scripts/build-data.mjs && node scripts/build-hanja.mjs",
    "test": "vitest run",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "kanjidic2-json": "^0.1.0",
    "sax": "^1.6.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
